
---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About | Guanche Warriors">
	<article class="about-page">

		<header class="about-header">
			<span class="eyebrow">ABOUT THE GAME</span>

			<h1>A World Inspired by the Canary Islands</h1>

			<p>
				Guanche Warriors is an independent 2.5D turn-based JRPG
				inspired by the culture, landscapes and heritage
				of the Canary Islands.
			</p>
		</header>

		<section class="about-section">
			<h2>The World</h2>

			<p>
				Explore an original fantasy setting inspired by
				the unique identity of the Canary Islands,
				where adventure, exploration and mystery
				come together.
			</p>

			<p>
				The project aims to bring a distinctive setting
				to the classic JRPG experience, combining
				traditional gameplay elements with an
				original creative vision.
			</p>
		</section>

		<section class="about-section">
			<h2>Core Features</h2>

			<ul>
				<li>Classic turn-based RPG gameplay.</li>
				<li>Exploration and character-driven adventures.</li>
				<li>A distinctive visual identity.</li>
				<li>
					An original fantasy world inspired
					by the Canary Islands.
				</li>
			</ul>
		</section>

		<section class="about-section">
			<h2>Development Journey</h2>

			<p>
				Guanche Warriors is currently in early development,
				with a focus on building its core gameplay systems
				and working towards a playable demo.
			</p>

			<p>
				This development journal documents the technical
				challenges, experiments and lessons learned
				throughout the production process.
			</p>

			<a href={`${import.meta.env.BASE_URL}devlog/`}>
				Follow the Development Journal →
			</a>
		</section>

	</article>
</MainLayout>

<style>
	.about-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 80px 40px;
	}

	.about-header {
		margin-bottom: 70px;
	}

	.eyebrow {
		color: #d69b48;
		font-size: 12px;
		font-weight: bold;
		letter-spacing: 3px;
	}

	h1 {
		font-size: clamp(36px, 6vw, 64px);
		line-height: 1.2;
		margin: 20px 0;
	}

	.about-header p {
		color: #aeb5b9;
		font-size: 19px;
		line-height: 1.8;
	}

	.about-section {
		margin-bottom: 64px;
	}

	h2 {
		color: #d69b48;
		font-size: 28px;
	}

	.about-section p,
	.about-section li {
		color: #c5c9c6;
		line-height: 1.9;
	}

	.about-section a {
		display: inline-block;
		margin-top: 20px;
		color: #d69b48;
		text-decoration: none;
		font-weight: bold;
	}

	.about-section a:hover {
		color: #e8e0cf;
	}

	@media (max-width: 600px) {
		.about-page {
			padding: 50px 20px;
		}
	}
</style>
