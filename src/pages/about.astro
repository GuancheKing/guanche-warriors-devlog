
---
import MainLayout from "../layouts/MainLayout.astro";

const base = import.meta.env.BASE_URL;

const socialLinks = [
	{
		name: "GitHub",
		handle: "@GuancheKing",
		url: "https://github.com/GuancheKing",
	},
	{
		name: "Mastodon",
		handle: "@guancheking",
		url: "https://mastodon.social/@guancheking",
	},
	{
		name: "Bluesky",
		handle: "@guancheking.bsky.social",
		url: "https://bsky.app/profile/guancheking.bsky.social",
	},
	{
		name: "LinkedIn",
		handle: "Pepo Jiménez",
		url: "https://www.linkedin.com/in/pepo-j-80a33052/",
	},
    {
        name: "itch.io",
        handle: "GuancheKing",
        url: "https://itch.io/profile/guancheking",
    },
];

const collaboratorLinks = [
	{
		name: "GitHub",
		handle: "carpinterzeta",
		url: "https://github.com/carpinterzeta",
	},
	{
		name: "Mastodon",
		handle: "@ak4rp",
		url: "https://mastodon.social/@ak4rp",
	},
];
---

<MainLayout title="About | Guanche Warriors">
	<main class="about-page">

		<!-- ABOUT THE PROJECT -->

		<header class="about-header">
			<span class="eyebrow">ABOUT THE PROJECT</span>

			<h1>
				A world inspired by{" "}
				<span class="highlight">the Canary Islands.</span>
			</h1>

			<p class="intro">
				Guanche Warriors is an independent 2.5D turn-based JRPG
				inspired by the culture, landscapes and heritage
				of the Canary Islands.
			</p>

			<p>
				The project brings together my love for classic JRPGs,
				storytelling and game development in an original
				fantasy setting.
			</p>

			<p>
				It's currently in early development, with the goal
				of building a playable demo and gradually bringing
				its world to life.
			</p>

			<a href={`${base}roadmap/`} class="text-link">
				Explore the roadmap →
			</a>
		</header>

		<!-- BEHIND THE GAME -->

		<section class="about-section developer-section">
			<span class="eyebrow">BEHIND THE GAME</span>

			<h2>
				Hi, I'm{" "}
				<span class="highlight">Pepo.</span>
			</h2>

			<div class="developer-content">
				<div class="developer-description">
					<p>
						I'm a{" "}
						<strong>programmer in the making</strong>,
						with a background in digital marketing
						and audiovisual production.
					</p>

					<p>
						I've always been interested in video games,
						not only as a player, but also in how they're
						designed, developed and brought to life.
						Eventually, I decided to take the leap and
						learn how to make them myself.
					</p>

					<p>
                        These days, I'm studying programming at{" "}
                        <strong>42 Madrid</strong> and developing games
                        with <strong>Unity and C#</strong>. I also work
                        with <strong>Python</strong> and have hands-on
                        experience with <strong>Godot</strong> through
                        game jams and collaborative projects.
					</p>
				</div>

				<aside class="developer-note">
					<span class="note-label">
						DEVELOPER NOTE / 001
					</span>

					<p>
						“I used to wonder how games worked.
						Now I spend my days breaking things
						to find out.”
					</p>

					<span class="note-signature">
						@GUANCHEKING
					</span>
				</aside>
			</div>

			<!-- PERSONAL LINKS -->

			<div class="personal-links">
				<h3>Find me online</h3>

				<p>
					Interested in collaborating, sharing ideas
					or just talking about game development?
					Feel free to reach out through any of these platforms.
				</p>

				<div class="profile-links">
					{socialLinks.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${social.name}: ${social.handle}, opens in a new tab`}
						>
							<span class="profile-platform">
								{social.name}
							</span>

							<span class="profile-handle">
								{social.handle}
							</span>

							<span class="external-arrow" aria-hidden="true">
								↗
							</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- COLLABORATION -->

		<section class="about-section collaboration-section">
			<span class="eyebrow">COLLABORATION</span>

			<h2>Not entirely a solo journey.</h2>

			<p>
				Guanche Warriors is my personal project,
				but I'm not building it entirely on my own.
				Other developers are also helping bring
				parts of the game to life.
			</p>

			<div class="collaborator-card">
				<div class="collaborator-info">
					<span class="collaborator-label">
						CONTRIBUTOR
					</span>

					<h3>carpinterzeta</h3>

					<p>
						Contributing to gameplay features
						and the development of Guanche Warriors.
					</p>
				</div>

				<div class="collaborator-links">
					{collaboratorLinks.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${link.name}: ${link.handle}, opens in a new tab`}
						>
							<span>{link.name}</span>

							<span class="profile-handle">
								{link.handle}
							</span>

							<span aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- DEVELOPMENT JOURNEY -->

		<section class="about-section journey-section">
			<span class="eyebrow">THE DEVELOPMENT JOURNEY</span>

			<h2>Learning by building.</h2>

			<p>
				Guanche Warriors is both a creative project
				and an opportunity to put my programming
				skills into practice.
			</p>

			<p>
				This devlog is where I document the process:
				what I'm working on, the technical problems
				I encounter, the mistakes I make and the
				solutions I find along the way.
			</p>

			<p>
				Some posts focus on Guanche Warriors itself,
				while others explore programming concepts,
				experiments and lessons from other projects.
			</p>

			<a href={`${base}devlog/`} class="text-link">
				Read the development journal →
			</a>
		</section>

	</main>
</MainLayout>

<style>
	/* PAGE LAYOUT */

	.about-page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 90px 40px 110px;
	}

	.eyebrow {
		display: block;
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 2px;
		line-height: 1.6;
	}

	.highlight {
		color: var(--color-coral);
	}

	/* ABOUT THE PROJECT */

	.about-header {
		max-width: 850px;
		margin-bottom: 100px;
	}

	.about-header h1 {
		font-size: clamp(42px, 6vw, 72px);
		line-height: 1.1;
		letter-spacing: -2px;
		margin: 28px 0 32px;
	}

	.about-header .intro {
		color: var(--color-text);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.6;
	}

	.about-header p {
		max-width: 720px;
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.9;
		margin: 0 0 22px;
	}

	.text-link {
		display: inline-block;
		margin-top: 16px;
		color: var(--color-coral);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-turquoise);
	}

	/* SHARED SECTIONS */

	.about-section {
		border-top: 1px solid var(--color-border);
		padding-top: 70px;
		margin-bottom: 100px;
	}

	.about-section h2 {
		color: var(--color-text);
		font-size: clamp(30px, 4vw, 42px);
		letter-spacing: -1px;
		line-height: 1.2;
		margin: 16px 0 30px;
	}

	.about-section > p {
		max-width: 720px;
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.9;
		margin: 0 0 22px;
	}

	/* BEHIND THE GAME */

	.developer-content {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 48px;
		align-items: start;
	}

	.developer-description p {
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.9;
		margin: 0 0 24px;
	}

	.developer-description strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.developer-note {
		background: var(--color-surface);
		border-left: 3px solid var(--color-coral);
		padding: 28px;
	}

	.note-label,
	.note-signature {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 1px;
	}

	.note-label {
		color: var(--color-yellow);
	}

	.developer-note p {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 24px;
		font-weight: 600;
		line-height: 1.4;
		margin: 24px 0;
	}

	.note-signature {
		color: var(--color-turquoise);
	}

	/* PERSONAL LINKS */

	.personal-links {
		margin-top: 55px;
	}

	.personal-links h3 {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 23px;
		margin: 0 0 10px;
	}

	.personal-links > p {
		max-width: 690px;
		color: var(--color-text-muted);
		font-size: 15px;
		line-height: 1.8;
		margin: 0;
	}

	.profile-links {
		display: flex;
		flex-wrap: wrap;
		column-gap: 32px;
		row-gap: 18px;
		margin-top: 26px;
	}

	.profile-links a,
	.collaborator-links a {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		color: var(--color-coral);
		font-family: var(--font-mono);
		font-size: 12px;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.profile-links a:hover,
	.collaborator-links a:hover {
		color: var(--color-turquoise);
	}

	.profile-links a:focus-visible,
	.collaborator-links a:focus-visible {
		outline: 2px solid var(--color-turquoise);
		outline-offset: 4px;
	}

	.profile-handle {
		color: var(--color-text-muted);
		overflow-wrap: anywhere;
	}

	.external-arrow {
		font-size: 15px;
		line-height: 1;
	}

	/* COLLABORATION */

	.collaborator-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 30px;
		align-items: center;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 30px;
		margin-top: 30px;
	}

	.collaborator-label {
		color: var(--color-yellow);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 1px;
	}

	.collaborator-info h3 {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 26px;
		margin: 14px 0;
	}

	.collaborator-info p {
		color: var(--color-text-muted);
		font-size: 15px;
		line-height: 1.7;
		margin: 0;
	}

	.collaborator-links {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	/* RESPONSIVE */

	@media (max-width: 700px) {
		.developer-content {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.collaborator-card {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	@media (max-width: 600px) {
		.about-page {
			padding: 60px 20px 80px;
		}

		.about-header {
			margin-bottom: 70px;
		}

		.eyebrow {
			font-size: 10px;
			letter-spacing: 1.5px;
		}

		.about-header h1 {
			font-size: clamp(38px, 9vw, 52px);
			letter-spacing: -1.5px;
			margin: 24px 0;
		}

		.about-header .intro {
			font-size: 18px;
		}

		.about-header p,
		.about-section > p,
		.developer-description p {
			font-size: 15px;
		}

		.about-section {
			padding-top: 50px;
			margin-bottom: 70px;
		}

		.developer-note {
			padding: 24px;
		}

		.personal-links {
			margin-top: 35px;
		}

		.profile-links {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
		}

		.collaborator-card {
			padding: 24px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.text-link,
		.profile-links a,
		.collaborator-links a {
			transition: none;
		}
	}
</style>
