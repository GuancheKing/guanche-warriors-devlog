
---
import MainLayout from "../layouts/MainLayout.astro";

const milestones = [
	{
		title: "Project Foundations",
		description:
			"Initial Unity project setup, development environment and core architecture.",
		status: "completed"
	},
	{
		title: "Exploration Systems",
		description:
			"Foundational character movement, interactions and exploration mechanics.",
		status: "completed"
	},
	{
		title: "Gameplay Development",
		description:
			"Expanding the core gameplay systems and refining the player experience.",
		status: "in-progress"
	},
	{
		title: "Visual Development",
		description:
			"Exploring the artistic direction, environments and visual identity.",
		status: "in-progress"
	},
	{
		title: "Core Gameplay Integration",
		description:
			"Bringing the main gameplay systems together into a cohesive experience.",
		status: "planned"
	},
	{
		title: "Playable Demo",
		description:
			"Preparing a first playable experience to showcase the project's vision.",
		status: "planned"
	}
];

const completedMilestones = milestones.filter(
	(milestone) => milestone.status === "completed"
);

const inProgressMilestones = milestones.filter(
	(milestone) => milestone.status === "in-progress"
);

const plannedMilestones = milestones.filter(
	(milestone) => milestone.status === "planned"
);
---

<MainLayout title="Roadmap | Guanche Warriors">
	<div class="roadmap-page">

		<header class="roadmap-header">
			<span class="eyebrow">DEVELOPMENT PROGRESS</span>

			<h1>Development Roadmap</h1>

			<p>
				Follow the journey of Guanche Warriors,
				from its early foundations to a playable JRPG demo.
			</p>

			<p class="roadmap-note">
				This roadmap provides a high-level overview
				of development progress. Features and priorities
				may evolve throughout production.
			</p>
		</header>

		<section class="roadmap-section">
			<h2>Completed Milestones</h2>

			<div class="milestone-list">
				{completedMilestones.map((milestone) => (
					<article class="milestone-card">
						<span class="status completed">
							Completed
						</span>

						<h3>{milestone.title}</h3>

						<p>{milestone.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="roadmap-section">
			<h2>In Progress</h2>

			<div class="milestone-list">
				{inProgressMilestones.map((milestone) => (
					<article class="milestone-card">
						<span class="status in-progress">
							In Progress
						</span>

						<h3>{milestone.title}</h3>

						<p>{milestone.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="roadmap-section">
			<h2>Upcoming Milestones</h2>

			<div class="milestone-list">
				{plannedMilestones.map((milestone) => (
					<article class="milestone-card">
						<span class="status planned">
							Planned
						</span>

						<h3>{milestone.title}</h3>

						<p>{milestone.description}</p>
					</article>
				))}
			</div>
		</section>

		<footer class="roadmap-footer">
			<p>
				Want to follow the development journey?
			</p>

			<a href={`${import.meta.env.BASE_URL}devlog/`}>
				Explore the Development Journal →
			</a>
		</footer>

	</div>
</MainLayout>

<style>
	.roadmap-page {
		max-width: 950px;
		margin: 0 auto;
		padding: 80px 40px;
	}

	.roadmap-header {
		margin-bottom: 64px;
	}

	.eyebrow {
		color: #d69b48;
		font-size: 12px;
		font-weight: bold;
		letter-spacing: 3px;
	}

	h1 {
		font-size: clamp(36px, 6vw, 60px);
		margin: 20px 0;
	}

	.roadmap-header p {
		color: #aeb5b9;
		line-height: 1.8;
	}

	.roadmap-note {
		margin-top: 24px;
		font-size: 13px;
		font-style: italic;
		color: #92999e;
	}

	.roadmap-section {
		margin-bottom: 60px;
	}

	h2 {
		color: #d69b48;
		margin-bottom: 24px;
	}

	.milestone-list {
		display: grid;
		gap: 16px;
	}

	.milestone-card {
		background: #242c32;
		border: 1px solid #394047;
		border-radius: 6px;
		padding: 24px;
	}

	.status {
		display: inline-block;
		font-size: 11px;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.completed {
		color: #75a68b;
	}

	.in-progress {
		color: #d69b48;
	}

	.planned {
		color: #92999e;
	}

	h3 {
		color: #e8e0cf;
		margin: 12px 0;
	}

	.milestone-card p {
		color: #aeb5b9;
		font-size: 14px;
		line-height: 1.7;
		margin-bottom: 0;
	}

	.roadmap-footer {
		border-top: 1px solid #394047;
		padding-top: 32px;
		margin-top: 40px;
	}

	.roadmap-footer p {
		color: #aeb5b9;
	}

	.roadmap-footer a {
		display: inline-block;
		margin-top: 12px;
		color: #d69b48;
		font-weight: bold;
		text-decoration: none;
	}

	.roadmap-footer a:hover {
		color: #e8e0cf;
	}

	@media (max-width: 600px) {
		.roadmap-page {
			padding: 50px 20px;
		}

		.milestone-card {
			padding: 20px;
		}
	}
</style>
