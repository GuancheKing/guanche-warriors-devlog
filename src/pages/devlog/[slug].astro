
---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection(
		"devlog",
		({ data }) => data.draft !== true
	);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;

const { Content } = await render(post);

const base = import.meta.env.BASE_URL;

const { title, description, pubDate, category } = post.data;

const isDeveloperNote = post.data.series === "developer-notes";

const seriesLabel = isDeveloperNote
	? "DEVELOPER NOTES"
	: "GUANCHE WARRIORS";

const formattedDate = pubDate.toLocaleDateString("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<MainLayout title={`${title} | Guanche Warriors`}>
	<main
		class:list={[
			"post-page",
			{ "developer-note": isDeveloperNote },
		]}
	>
		<article>

			<!-- ARTICLE HEADER -->

			<header class="post-header">
				<a href={`${base}devlog/`} class="back-link">
					<span aria-hidden="true">←</span>
					BACK TO DEVLOG
				</a>

				<div class="post-tags">
					<span class="series-label">
						{seriesLabel}
					</span>

					{category && (
						<span class="category">
							{category}
						</span>
					)}
				</div>

				<h1>{title}</h1>

				<p class="description">
					{description}
				</p>

				<div class="post-meta">
					<time datetime={pubDate.toISOString()}>
						{formattedDate}
					</time>

					<span class="meta-divider" aria-hidden="true">
						/
					</span>

					<span>DEVELOPMENT JOURNAL</span>
				</div>
			</header>

			<!-- MARKDOWN CONTENT -->

			<div class="post-content">
				<Content />
			</div>

			<!-- ARTICLE FOOTER -->

			<footer class="post-footer">
				<div class="footer-divider"></div>

				<span class="footer-label">
					END OF ENTRY
				</span>

				<p>
					Thanks for reading. There's always more
					happening behind the scenes.
				</p>

				<a href={`${base}devlog/`} class="footer-link">
					<span aria-hidden="true">←</span>
					BACK TO ALL POSTS
				</a>
			</footer>

		</article>
	</main>
</MainLayout>

<style>
	/* PAGE LAYOUT */

	.post-page {
		--post-accent: var(--color-coral);

		max-width: 840px;
		margin: 0 auto;
		padding: 80px 40px 110px;
	}

	.post-page.developer-note {
		--post-accent: var(--color-turquoise);
	}

	/* ARTICLE HEADER */

	.post-header {
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 44px;
		margin-bottom: 48px;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 52px;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.5px;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--post-accent);
	}

	.back-link span {
		color: var(--post-accent);
		font-size: 17px;
		line-height: 1;
	}

	/* ARTICLE TAGS */

	.post-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 14px;
		margin-bottom: 24px;
	}

	.series-label {
		display: inline-block;
		padding: 7px 11px;
		border: 1px solid var(--post-accent);
		border-radius: 4px;
		color: var(--post-accent);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.8px;
	}

	.category {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.6px;
		text-transform: uppercase;
	}

	/* ARTICLE TITLE */

	.post-header h1 {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: clamp(36px, 5.5vw, 60px);
		font-weight: 700;
		letter-spacing: -1.7px;
		line-height: 1.13;
		margin: 0 0 26px;
		overflow-wrap: break-word;
	}

	.description {
		max-width: 720px;
		color: var(--color-text-muted);
		font-size: 19px;
		line-height: 1.7;
		margin: 0 0 30px;
	}

	/* ARTICLE META */

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.5px;
	}

	.meta-divider {
		color: var(--post-accent);
	}

	/* MARKDOWN CONTENT */

	.post-content {
		min-width: 0;
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.9;
		overflow-wrap: break-word;
	}

	.post-content :global(p) {
		margin: 0 0 25px;
	}

	.post-content :global(h2),
	.post-content :global(h3),
	.post-content :global(h4) {
		color: var(--color-text);
		font-family: var(--font-heading);
		line-height: 1.3;
		letter-spacing: -0.5px;
		scroll-margin-top: 40px;
	}

	.post-content :global(h2) {
		font-size: clamp(25px, 3.5vw, 32px);
		margin: 55px 0 22px;
	}

	.post-content :global(h3) {
		font-size: 23px;
		margin: 40px 0 18px;
	}

	.post-content :global(h4) {
		font-size: 19px;
		margin: 32px 0 14px;
	}

	.post-content :global(h2::before) {
		content: "";
		display: block;
		width: 32px;
		height: 3px;
		background: var(--post-accent);
		border-radius: 2px;
		margin-bottom: 18px;
	}

	/* LINKS */

	.post-content :global(a) {
		color: var(--post-accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: color 0.2s ease;
	}

	.post-content :global(a:hover) {
		color: var(--color-text);
	}

	/* EMPHASIS */

	.post-content :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	.post-content :global(em) {
		font-style: italic;
	}

	/* LISTS */

	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 26px;
		margin: 0 0 28px;
	}

	.post-content :global(li) {
		padding-left: 5px;
		margin-bottom: 10px;
	}

	.post-content :global(li::marker) {
		color: var(--post-accent);
	}

	.post-content :global(li > ul),
	.post-content :global(li > ol) {
		margin-top: 12px;
		margin-bottom: 12px;
	}

	/* BLOCKQUOTES */

	.post-content :global(blockquote) {
		background: var(--color-surface);
		border-left: 3px solid var(--post-accent);
		border-radius: 0 6px 6px 0;
		padding: 24px 28px;
		margin: 35px 0;
	}

	.post-content :global(blockquote p) {
		color: var(--color-text);
		font-size: 17px;
		font-style: italic;
		line-height: 1.8;
		margin: 0;
	}

	.post-content :global(blockquote p + p) {
		margin-top: 16px;
	}

	/* INLINE CODE */

	.post-content :global(:not(pre) > code) {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 4px;
		padding: 2px 6px;
		color: var(--color-yellow);
		font-family: var(--font-mono);
		font-size: 0.88em;
		overflow-wrap: anywhere;
	}

	/* CODE BLOCKS */

	.post-content :global(pre) {
		background: #101018;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 24px;
		margin: 32px 0;
		overflow-x: auto;
		max-width: 100%;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.7;
		tab-size: 4;
	}

	.post-content :global(pre code) {
		display: block;
		width: max-content;
		min-width: 100%;
		padding: 0;
		border: none;
		background: transparent;
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		white-space: pre;
	}

	/* IMAGES */

	.post-content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		margin: 34px auto;
	}

	.post-content :global(figure) {
		margin: 36px 0;
	}

	.post-content :global(figure img) {
		margin: 0 auto;
	}

	.post-content :global(figcaption) {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.7;
		text-align: center;
		margin-top: 12px;
	}

	/* TABLES */

	.post-content :global(table) {
		display: block;
		width: 100%;
		max-width: 100%;
		border-collapse: collapse;
		overflow-x: auto;
		margin: 32px 0;
		font-size: 14px;
	}

	.post-content :global(th),
	.post-content :global(td) {
		border: 1px solid var(--color-border);
		padding: 12px 16px;
		text-align: left;
		vertical-align: top;
	}

	.post-content :global(th) {
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.post-content :global(td) {
		color: var(--color-text-muted);
	}

	/* DIVIDERS */

	.post-content :global(hr) {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 50px 0;
	}

	/* ARTICLE FOOTER */

	.post-footer {
		margin-top: 80px;
	}

	.footer-divider {
		width: 100%;
		height: 1px;
		background: var(--color-border);
		margin-bottom: 35px;
	}

	.footer-label {
		color: var(--post-accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
	}

	.post-footer p {
		color: var(--color-text-muted);
		font-size: 15px;
		line-height: 1.8;
		margin: 18px 0 24px;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--post-accent);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.2s ease,
			gap 0.2s ease;
	}

	.footer-link:hover {
		color: var(--color-text);
		gap: 15px;
	}

	.footer-link span {
		font-size: 18px;
		line-height: 1;
	}

	/* ACCESSIBILITY */

	.back-link:focus-visible,
	.footer-link:focus-visible,
	.post-content :global(a:focus-visible) {
		outline: 2px solid var(--post-accent);
		outline-offset: 4px;
	}

	/* RESPONSIVE */

	@media (max-width: 600px) {
		.post-page {
			padding: 55px 20px 80px;
		}

		.post-header {
			padding-bottom: 35px;
			margin-bottom: 35px;
		}

		.back-link {
			margin-bottom: 35px;
		}

		.post-header h1 {
			font-size: clamp(34px, 9vw, 46px);
			letter-spacing: -1.2px;
		}

		.description {
			font-size: 17px;
		}

		.post-content {
			font-size: 15px;
			line-height: 1.85;
		}

		.post-content :global(h2) {
			margin-top: 42px;
		}

		.post-content :global(h3) {
			font-size: 21px;
		}

		.post-content :global(pre) {
			padding: 18px;
			font-size: 12px;
			border-radius: 6px;
		}

		.post-content :global(blockquote) {
			padding: 20px;
		}

		.post-content :global(blockquote p) {
			font-size: 15px;
		}

		.post-content :global(th),
		.post-content :global(td) {
			padding: 10px 12px;
		}

		.post-footer {
			margin-top: 60px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link,
		.footer-link,
		.post-content :global(a) {
			transition: none;
		}
	}
</style>
