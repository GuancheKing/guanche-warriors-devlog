
---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import DevlogCard from "../../components/DevlogCard.astro";

const posts = (await getCollection(
	"devlog",
	({ data }) => data.draft !== true
)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const guanchePosts = posts.filter(
	(post) => post.data.series === "guanche-warriors"
);

const developerNotes = posts.filter(
	(post) => post.data.series === "developer-notes"
);

---

<MainLayout title="Devlog | Guanche Warriors">
	<section class="devlog-page">
		<header class="page-heading">
			<span>THE DEVELOPMENT JOURNAL</span>
			<h1>Devlog</h1>
			<p>
				Follow the development journey of Guanche Warriors.
			</p>
		</header>


        <section class="posts-section">
            <h2>Guanche Warriors Development</h2>

            <p>
                Follow the development of Guanche Warriors,
                from gameplay systems to production milestones.
            </p>

            <div class="posts-grid">
                {guanchePosts.map((post) => (
                    <DevlogCard post={post} />
                ))}
            </div>
        </section>

        <section class="posts-section">
            <h2>Developer Notes</h2>

            <p>
                Programming challenges, experiments and lessons
                learned while developing games.
            </p>

            <div class="posts-grid">
                {developerNotes.map((post) => (
                    <DevlogCard post={post} />
                ))}
            </div>
        </section>

	</section>
</MainLayout>

<style>
	.devlog-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 80px 40px;
	}

	.page-heading {
		margin-bottom: 48px;
	}

	.page-heading span {
		color: #d69b48;
		font-size: 11px;
		letter-spacing: 3px;
		font-weight: bold;
	}

	.page-heading h1 {
		font-size: 48px;
		margin: 16px 0;
	}

	.page-heading p {
		color: #aeb5b9;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	@media (max-width: 600px) {
		.devlog-page {
			padding: 50px 20px;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}

		.page-heading h1 {
			font-size: 36px;
		}
	}
        .posts-section {
            margin-top: 64px;
        }

        .posts-section h2 {
            color: #d69b48;
            font-size: 28px;
            margin-bottom: 12px;
        }

        .posts-section > p {
            color: #aeb5b9;
            line-height: 1.7;
            margin-bottom: 28px;
        }

</style>
