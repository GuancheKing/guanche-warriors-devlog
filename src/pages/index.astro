
---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import DevlogCard from "../components/DevlogCard.astro";

const latestPosts = (await getCollection(
	"devlog",
	({ data }) => data.draft !== true
))
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	)
	.slice(0, 3);
---



<MainLayout title="Guanche Warriors | Development Journal">
	<section class="hero">
		<div class="hero-content">
			<span class="eyebrow">INDEPENDENT GAME DEVELOPMENT</span>

			<h1>GUANCHE WARRIORS</h1>

			<p class="hero-subtitle">
				A journey through the worlds of the Canary Islands.
			</p>

			<p class="hero-description">
				An indie turn-based JRPG inspired by Canarian mythology,
				culture and landscapes. Follow the development journey,
				from the first lines of code to a playable adventure.
			</p>

			<div class="hero-actions">
				<a href="#project" class="button-primary">
					Discover the project
				</a>

				<a href="#latest" class="button-secondary">
					Follow development
				</a>
			</div>
		</div>
	</section>

	<section id="project" class="project-intro">
		<h2>Building a world, one pixel at a time.</h2>
		<p>
			Welcome to the development journal of Guanche Warriors.
		</p>
	</section>


<section id="latest" class="latest-section">
	<h2>Latest development updates</h2>

	<p>Follow the latest progress of Guanche Warriors.</p>

	<div class="latest-grid">
		{latestPosts.map((post) => (
			<DevlogCard post={post} />
		))}
	</div>

    <a href={`${import.meta.env.BASE_URL}devlog/`} class="all-posts">
        VIEW ALL UPDATES →
    </a>
</section>

</MainLayout>

<style>
	.hero {
		min-height: 580px;
		display: flex;
		align-items: center;
		padding: 80px 40px;
	}

	.hero-content {
		max-width: 850px;
		margin: 0 auto;
	}

	.eyebrow {
		color: #d69b48;
		font-size: 12px;
		font-weight: bold;
		letter-spacing: 3px;
	}

	.hero h1 {
		font-size: clamp(38px, 7vw, 76px);
		letter-spacing: 2px;
		margin: 24px 0 12px;
		line-height: 1.1;
	}

	.hero-subtitle {
		font-size: 22px;
		color: #d69b48;
	}

	.hero-description {
		max-width: 650px;
		color: #aeb5b9;
		line-height: 1.8;
		font-size: 16px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 32px;
	}

	.hero-actions a {
		padding: 13px 20px;
		text-decoration: none;
		border-radius: 4px;
		font-size: 14px;
	}

	.button-primary {
		background: #d69b48;
		color: #15191d;
	}

	.button-secondary {
		border: 1px solid #59636b;
		color: #e8e0cf;
	}

	.project-intro,
	.latest-section {
		max-width: 850px;
		margin: 0 auto;
		padding: 60px 40px;
	}


.project-intro h2,
.latest-section h2 {
	color: #d69b48;
}

/* Latest development updates */

.latest-grid {
	display: grid;
	grid-template-columns: 1fr;
	gap: 24px;
	margin-top: 32px;
	margin-bottom: 24px;
}

.all-posts {
	display: inline-block;
	margin-top: 16px;
	color: #d69b48;
	font-size: 13px;
	font-weight: bold;
	text-decoration: none;
}

.all-posts:hover {
	color: #e8e0cf;
}

/* Responsive design */

@media (max-width: 600px) {
	.hero {
		min-height: auto;
		padding: 70px 20px;
	}

	.hero-subtitle {
		font-size: 18px;
	}

	.hero-description {
		font-size: 14px;
	}

	.project-intro,
	.latest-section {
		padding: 45px 20px;
	}
}
</style>

