---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<div class="header-container">
		<a href="/" class="brand">
			<span class="brand-name">GUANCHE WARRIORS</span>
			<span class="brand-subtitle">DEVELOPMENT JOURNAL</span>
		</a>

<nav aria-label="Main navigation">
	<a href={base}>Home</a>
	<a href={`${base}devlog/`}>Devlog</a>
	<a href={`${base}about/`}>About</a>
	<a href={`${base}roadmap/`}>Roadmap</a>
</nav>
	</div>
</header>

<style>
	.site-header {
		background: #15191d;
		border-bottom: 1px solid #394047;
		padding: 20px 40px;
	}

	.header-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
	}

	.brand-name {
		color: #e8e0cf;
		font-weight: bold;
		letter-spacing: 2px;
	}

	.brand-subtitle {
		color: #d69b48;
		font-size: 10px;
		letter-spacing: 2px;
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: #e8e0cf;
		text-decoration: none;
		font-size: 14px;
	}

	nav a:hover {
		color: #d69b48;
	}

@media (max-width: 600px) {
	.site-header {
		padding: 20px;
	}

	.header-container {
		flex-direction: column;
		gap: 20px;
	}

	nav {
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
	}
}
</style>
