
---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations, type Language } from "../i18n/ui";

interface Props {
	lang?: Language;
}

const { lang = "en" } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

const relativePath = currentPath.startsWith(base)
	? currentPath.slice(base.length)
	: currentPath.replace(/^\/+/, "");

const normalizedPath = relativePath
	.replace(/^es\/?/, "")
	.replace(/\/$/, "");

const translatedPages = [
	"",
	"about",
	"roadmap",
	"devlog",
];

const hasTranslation = translatedPages.includes(
	normalizedPath
);

const homeUrl = lang === "es"
	? `${base}es/`
	: base;

const aboutUrl = lang === "es"
	? `${base}es/about/`
	: `${base}about/`;

const roadmapUrl = lang === "es"
	? `${base}es/roadmap/`
	: `${base}roadmap/`;

const devlogUrl = lang === "es"
	? `${base}es/devlog/`
	: `${base}devlog/`;

const links = [
	{
		label: t("nav.home"),
		href: homeUrl,
	},
	{
		label: t("nav.devlog"),
		href: devlogUrl,
	},
	{
		label: t("nav.about"),
		href: aboutUrl,
	},
	{
		label: t("nav.roadmap"),
		href: roadmapUrl,
	},
];
---

<header class="site-header">
	<div class="header-container">
		<a
			href={homeUrl}
			class="brand"
			aria-label={lang === "es"
				? "Guanche Warriors — Ir al inicio"
				: "Guanche Warriors — Back to home"}
		>
			<img
				src={`${base}images/guancheking-logo.svg`}
				alt=""
				class="brand-logo"
				width="48"
				height="48"
			/>

			<div class="brand-text">
				<span class="brand-name">
					Guanche Warriors
				</span>

				<span class="brand-subtitle">
					{t("site.subtitle")}
				</span>
			</div>
		</a>

		<div class="header-right">
			<nav
				class="main-nav"
				aria-label={lang === "es"
					? "Navegación principal"
					: "Main navigation"}
			>
				{links.map((link) => (
					<a href={link.href}>
						{link.label}
					</a>
				))}
			</nav>

			{hasTranslation && (
				<LanguageSwitcher lang={lang} />
			)}
		</div>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-background);
		border-bottom: 1px solid var(--color-border);
		padding: 20px 40px;
	}

	.header-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
	}

	.brand-logo {
		width: 48px;
		height: 48px;
		object-fit: contain;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.brand:hover .brand-logo {
		transform: rotate(-4deg);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.brand-name {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.5px;
	}

	.brand-subtitle {
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 1px;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 28px;
	}

	.main-nav {
		display: flex;
		gap: 24px;
	}

	.main-nav a {
		color: var(--color-text);
		text-decoration: none;
		font-size: 14px;
		transition: color 0.2s ease;
	}

	.main-nav a:hover,
	.main-nav a:focus-visible {
		color: var(--color-coral);
	}

	@media (max-width: 850px) {
		.header-container {
			flex-wrap: wrap;
			justify-content: center;
		}

		.header-right {
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	@media (max-width: 600px) {
		.site-header {
			padding: 16px 20px;
		}

		.header-container {
			flex-direction: column;
			gap: 12px;
		}

		.brand-logo {
			width: 42px;
			height: 42px;
		}

		.brand-name {
			font-size: 18px;
		}

		.header-right {
			gap: 18px;
		}

		.main-nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-logo,
		.main-nav a {
			transition: none;
		}
	}
</style>
