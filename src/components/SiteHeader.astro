
---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<div class="header-container">
		<a href={base} class="brand">
			<img
				src={`${base}images/guancheking-logo.svg`}
				alt=""
				class="brand-logo"
				width="48"
				height="48"
			/>

			<div class="brand-text">
				<span class="brand-name">Guanche Warriors</span>
				<span class="brand-subtitle">DEVELOPMENT JOURNAL</span>
			</div>
		</a>

		<nav aria-label="Main navigation">
			<a href={base}>Home</a>
			<a href={`${base}devlog/`}>Devlog</a>
			<a href={`${base}about/`}>About</a>
			<a href={`${base}roadmap/`}>Roadmap</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-background);
		border-bottom: 1px solid var(--color-border);
		padding: 20px 40px;
	}

	.header-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
	}

	.brand-logo {
		width: 48px;
		height: 48px;
		object-fit: contain;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.brand:hover .brand-logo {
		transform: rotate(-4deg);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.brand-name {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.5px;
	}

	.brand-subtitle {
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 1px;
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: var(--color-text);
		text-decoration: none;
		font-size: 14px;
		transition: color 0.2s ease;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--color-coral);
	}

	@media (max-width: 600px) {
		.site-header {
			padding: 16px 20px;
		}

		.header-container {
			flex-direction: column;
			gap: 12px;
		}

		.brand-logo {
			width: 42px;
			height: 42px;
		}

		nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 16px;
		}
	}
</style>
