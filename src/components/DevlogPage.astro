
---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import MainLayout from "../layouts/MainLayout.astro";
import DevlogCard from "./DevlogCard.astro";

import type { Language } from "../i18n/ui";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const content = {
	en: {
		pageTitle: "Devlog | Guanche Warriors",
		eyebrow: "THE DEVELOPMENT JOURNAL",
		heading: "The",
		headingAccent: "Devlog.",
		intro:
			"Building a game is a journey of experiments, challenges and discoveries. This is where I document mine.",
		description:
			"Follow the development of Guanche Warriors, explore programming challenges and see what I'm learning along the way.",

		gameLabel: "THE GAME",
		gameHeading: "Guanche Warriors",
		gameAccent: "Development.",
		gameDescription:
			"Behind the scenes of an independent JRPG, from early prototypes to development milestones.",

		notesLabel: "BEYOND THE GAME",
		notesHeading: "Developer",
		notesAccent: "Notes.",
		notesDescription:
			"Programming challenges, experiments and lessons learned while making games and exploring new technologies.",

		postSingular: "POST",
		postPlural: "POSTS",

		emptyGame: "Development updates are on their way.",
		emptyNotes: "More notes and experiments coming soon.",
	},

	es: {
		pageTitle: "Devlog | Guanche Warriors",
		eyebrow: "DIARIO DE DESARROLLO",
		heading: "El",
		headingAccent: "Devlog.",
		intro:
			"Crear un videojuego es un camino lleno de experimentos, retos y descubrimientos. Aquí documento el mío.",
		description:
			"Sigue el desarrollo de Guanche Warriors, descubre retos de programación y acompáñame en todo lo que voy aprendiendo.",

		gameLabel: "EL JUEGO",
		gameHeading: "Desarrollo de",
		gameAccent: "Guanche Warriors.",
		gameDescription:
			"El desarrollo de un JRPG indie desde dentro: primeros prototipos, sistemas de gameplay y avances del proyecto.",

		notesLabel: "MÁS ALLÁ DEL JUEGO",
		notesHeading: "Developer",
		notesAccent: "Notes.",
		notesDescription:
			"Retos de programación, experimentos y aprendizajes mientras desarrollo videojuegos y exploro nuevas tecnologías.",

		postSingular: "PUBLICACIÓN",
		postPlural: "PUBLICACIONES",

		emptyGame: "Próximamente habrá nuevas publicaciones sobre el juego.",
		emptyNotes: "Próximamente compartiré más experimentos y aprendizajes.",
	},
};

const t = content[lang];

const allPosts = await getCollection(
	"devlog",
	({ data }) => data.draft !== true
);

// Los artículos ingleses actuales están en la raíz de la colección.
// Las traducciones españolas se guardarán en la carpeta "es".
const englishPosts = allPosts
	.filter((post) => !post.id.startsWith("es/"))
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

const spanishPosts = new Map(
	allPosts
		.filter((post) => post.id.startsWith("es/"))
		.map((post) => [
			post.id.replace(/^es\//, ""),
			post,
		])
);

const posts: CollectionEntry<"devlog">[] =
	lang === "es"
		? englishPosts.map(
				(post) => spanishPosts.get(post.id) ?? post
			)
		: englishPosts;

const guanchePosts = posts.filter(
	(post) => post.data.series === "guanche-warriors"
);

const developerNotes = posts.filter(
	(post) => post.data.series === "developer-notes"
);
---

<MainLayout
	title={t.pageTitle}
	lang={lang}
	hasTranslation={true}
>
	<main class="devlog-page">

		<!-- PAGE HEADER -->

		<header class="page-heading">
			<span class="eyebrow">
				{t.eyebrow}
			</span>

			<h1>
				{t.heading}{" "}
				<span class="highlight">
					{t.headingAccent}
				</span>
			</h1>

			<p class="page-intro">
				{t.intro}
			</p>

			<p class="page-description">
				{t.description}
			</p>
		</header>

		<!-- GUANCHE WARRIORS -->

		<section
			class="posts-section guanche-section"
			aria-labelledby="guanche-heading"
		>
			<div class="section-header">
				<div class="section-intro">
					<span class="section-eyebrow">
						{t.gameLabel}
					</span>

					<h2 id="guanche-heading">
						{t.gameHeading}{" "}
						<span class="section-highlight">
							{t.gameAccent}
						</span>
					</h2>

					<p>{t.gameDescription}</p>
				</div>

				<span class="post-count">
					{String(guanchePosts.length).padStart(2, "0")}{" "}
					{guanchePosts.length === 1
						? t.postSingular
						: t.postPlural}
				</span>
			</div>

			{guanchePosts.length > 0 ? (
				<div class="posts-grid">
					{guanchePosts.map((post) => (
						<DevlogCard
							post={post}
							lang={lang}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					{t.emptyGame}
				</p>
			)}
		</section>

		<!-- DEVELOPER NOTES -->

		<section
			class="posts-section notes-section"
			aria-labelledby="notes-heading"
		>
			<div class="section-header">
				<div class="section-intro">
					<span class="section-eyebrow">
						{t.notesLabel}
					</span>

					<h2 id="notes-heading">
						{t.notesHeading}{" "}
						<span class="section-highlight">
							{t.notesAccent}
						</span>
					</h2>

					<p>{t.notesDescription}</p>
				</div>

				<span class="post-count">
					{String(developerNotes.length).padStart(2, "0")}{" "}
					{developerNotes.length === 1
						? t.postSingular
						: t.postPlural}
				</span>
			</div>

			{developerNotes.length > 0 ? (
				<div class="posts-grid">
					{developerNotes.map((post) => (
						<DevlogCard
							post={post}
							lang={lang}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					{t.emptyNotes}
				</p>
			)}
		</section>

	</main>
</MainLayout>

<style>
	/* PAGE */

	.devlog-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 90px 40px 110px;
	}

	/* HEADER */

	.page-heading {
		max-width: 850px;
		margin-bottom: 100px;
	}

	.eyebrow {
		display: block;
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 2px;
		line-height: 1.6;
	}

	.page-heading h1 {
		color: var(--color-text);
		font-size: clamp(42px, 6vw, 72px);
		letter-spacing: -2px;
		line-height: 1.1;
		margin: 28px 0 32px;
	}

	.highlight {
		color: var(--color-coral);
	}

	.page-intro {
		max-width: 740px;
		color: var(--color-text);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.6;
		margin: 0 0 20px;
	}

	.page-description {
		max-width: 720px;
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.9;
		margin: 0;
	}

	/* SECTIONS */

	.posts-section {
		--section-accent: var(--color-coral);

		border-top: 1px solid var(--color-border);
		padding-top: 65px;
		margin-bottom: 100px;
	}

	.posts-section:last-child {
		margin-bottom: 0;
	}

	.notes-section {
		--section-accent: var(--color-turquoise);
	}

	.section-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 30px;
		margin-bottom: 35px;
	}

	.section-intro {
		max-width: 700px;
	}

	.section-eyebrow {
		display: block;
		color: var(--section-accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
	}

	.section-header h2 {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: clamp(30px, 4vw, 42px);
		letter-spacing: -1px;
		line-height: 1.2;
		margin: 16px 0 20px;
	}

	.section-highlight {
		color: var(--section-accent);
	}

	.section-header p {
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.8;
		margin: 0;
	}

	.post-count {
		flex-shrink: 0;
		color: var(--section-accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.6px;
		white-space: nowrap;
		margin-top: 4px;
	}

	/* POSTS */

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	.empty-state {
		background: var(--color-surface);
		border: 1px dashed var(--color-border);
		border-radius: 8px;
		padding: 35px;
		color: var(--color-text-muted);
		font-size: 15px;
		line-height: 1.7;
		text-align: center;
	}

	/* RESPONSIVE */

	@media (max-width: 700px) {
		.section-header {
			flex-direction: column;
			gap: 16px;
		}

		.post-count {
			margin-top: 0;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.devlog-page {
			padding: 60px 20px 80px;
		}

		.page-heading {
			margin-bottom: 70px;
		}

		.eyebrow {
			font-size: 10px;
			letter-spacing: 1.5px;
		}

		.page-heading h1 {
			font-size: clamp(38px, 9vw, 52px);
			letter-spacing: -1.5px;
			margin: 24px 0;
		}

		.page-intro {
			font-size: 18px;
		}

		.page-description {
			font-size: 15px;
		}

		.posts-section {
			padding-top: 50px;
			margin-bottom: 70px;
		}

		.section-header {
			margin-bottom: 28px;
		}

		.section-header p {
			font-size: 15px;
		}

		.posts-grid {
			gap: 18px;
		}

		.empty-state {
			padding: 25px;
		}
	}
</style>
