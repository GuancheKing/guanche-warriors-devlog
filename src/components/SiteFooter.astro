
---
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">

		<div class="footer-brand">
			<a
				href={base}
				class="brand-link"
				aria-label="Guanche Warriors — Back to home"
			>
				<img
					src={`${base}images/guancheking-logo.svg`}
					alt=""
					width="42"
					height="42"
				/>

				<div class="brand-text">
					<span class="brand-name">
						GUANCHE WARRIORS
					</span>

					<span class="brand-subtitle">
						DEVELOPMENT JOURNAL
					</span>
				</div>
			</a>

			<p>
				An independent JRPG inspired by the Canary Islands.
			</p>
		</div>

		<div class="footer-bottom">
			<span class="copyright">
				© {currentYear} Guanche Warriors
			</span>

			<div class="footer-links">
				<a href={`${base}about/`}>
					About
				</a>

				<a
					href="https://github.com/GuancheKing"
					target="_blank"
					rel="noopener noreferrer"
				>
					GitHub ↗
				</a>
			</div>
		</div>

	</div>
</footer>

<style>
	/* FOOTER */

	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-background);
		padding: 50px 40px 30px;
	}

	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	/* BRAND */

	.footer-brand {
		margin-bottom: 45px;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
	}

	.brand-link img {
		display: block;
		width: 42px;
		height: 42px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.brand-name {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.6px;
		line-height: 1.2;
		transition: color 0.2s ease;
	}

	.brand-link:hover .brand-name {
		color: var(--color-coral);
	}

	.brand-subtitle {
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 1.5px;
	}

	.footer-brand p {
		max-width: 420px;
		color: var(--color-text-muted);
		font-size: 14px;
		line-height: 1.7;
		margin: 22px 0 0;
	}

	/* FOOTER BOTTOM */

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px;
		border-top: 1px solid var(--color-border);
		padding-top: 25px;
	}

	.copyright {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
	}

	.footer-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 25px;
	}

	.footer-links a {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-links a:hover {
		color: var(--color-coral);
	}

	.brand-link:focus-visible,
	.footer-links a:focus-visible {
		outline: 2px solid var(--color-turquoise);
		outline-offset: 5px;
	}

	/* RESPONSIVE */

	@media (max-width: 600px) {
		.site-footer {
			padding: 40px 20px 25px;
		}

		.footer-brand {
			margin-bottom: 35px;
		}

		.brand-link img {
			width: 38px;
			height: 38px;
		}

		.brand-name {
			font-size: 14px;
		}

		.brand-subtitle {
			font-size: 9px;
		}

		.footer-brand p {
			font-size: 13px;
		}

		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-name,
		.footer-links a {
			transition: none;
		}
	}
</style>
