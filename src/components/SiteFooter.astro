
---
import type { Language } from "../i18n/ui";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const currentPath = Astro.url.pathname;

const relativePath = currentPath.startsWith(base)
	? currentPath.slice(base.length)
	: currentPath.replace(/^\/+/, "");

const lang: Language =
	relativePath === "es" || relativePath.startsWith("es/")
		? "es"
		: "en";

const prefix = lang === "es" ? `${base}es/` : base;

const content = {
	en: {
		description:
			"An indie turn-based JRPG inspired by the Canary Islands. Built with curiosity, creativity and a lot of debugging.",
		navigation: "EXPLORE",
		home: "Home",
		devlog: "Devlog",
		about: "About",
		roadmap: "Roadmap",
		follow: "FOLLOW THE DEVELOPMENT",
		articlesNote: "Devlog articles are published in English.",
		copyright: "An independent game development project.",
	},
	es: {
		description:
			"Un JRPG indie de combate por turnos inspirado en las Islas Canarias. Desarrollado con curiosidad, creatividad y muchas sesiones de debugging.",
		navigation: "EXPLORAR",
		home: "Inicio",
		devlog: "Devlog",
		about: "Sobre el proyecto",
		roadmap: "Roadmap",
		follow: "SIGUE EL DESARROLLO",
		articlesNote: "Los artículos del Devlog están publicados en inglés.",
		copyright: "Un proyecto independiente de desarrollo de videojuegos.",
	},
};

const t = content[lang];

const navigation = [
	{ label: t.home, href: prefix },
	{ label: t.devlog, href: `${prefix}devlog/` },
	{ label: t.about, href: `${prefix}about/` },
	{ label: t.roadmap, href: `${prefix}roadmap/` },
];

const socialLinks = [
	{
		label: "GitHub",
		url: "https://github.com/GuancheKing",
	},
	{
		label: "itch.io",
		url: "https://itch.io/profile/guancheking",
	},
	{
		label: "Mastodon",
		url: "https://mastodon.social/@guancheking",
	},
	{
		label: "Bluesky",
		url: "https://bsky.app/profile/guancheking.bsky.social",
	},
];
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-grid">

			<div class="footer-brand">
				<a href={prefix} class="brand-title">
					Guanche<span>Warriors.</span>
				</a>

				<p>{t.description}</p>
			</div>

			<div class="footer-column">
				<h2>{t.navigation}</h2>

				<nav
					aria-label={lang === "es"
						? "Navegación del pie de página"
						: "Footer navigation"}
				>
					{navigation.map((link) => (
						<a href={link.href}>
							{link.label}
						</a>
					))}
				</nav>
			</div>

			<div class="footer-column">
				<h2>{t.follow}</h2>

				<div class="social-links">
					{socialLinks.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.label}
							<span aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</div>

		</div>

		<div class="footer-bottom">
			<div class="footer-bottom-left">
				<span>
					© {new Date().getFullYear()} Guanche Warriors
				</span>

				<span>{t.copyright}</span>
			</div>

			<span class="footer-language-note">
				{t.articlesNote}
			</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-surface);
		padding: 65px 40px 28px;
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
		gap: 55px;
		padding-bottom: 65px;
	}

	.brand-title {
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: 26px;
		font-weight: 700;
		letter-spacing: -1px;
		text-decoration: none;
	}

	.brand-title span {
		color: var(--color-coral);
	}

	.footer-brand p {
		max-width: 345px;
		color: var(--color-text-muted);
		font-size: 14px;
		line-height: 1.9;
		margin: 18px 0 0;
	}

	.footer-column h2 {
		color: var(--color-turquoise);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 1.5px;
		margin: 8px 0 22px;
	}

	.footer-column nav,
	.social-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 15px;
	}

	.footer-column a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--color-text-muted);
		font-size: 14px;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-column a:hover,
	.footer-column a:focus-visible {
		color: var(--color-coral);
	}

	.social-links span {
		font-size: 13px;
	}

	.footer-bottom {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		border-top: 1px solid var(--color-border);
		padding-top: 24px;
	}

	.footer-bottom-left {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
	}

	.footer-bottom span {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1.7;
	}

	.footer-language-note {
		text-align: right;
	}

	@media (max-width: 700px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 36px;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}

		.footer-language-note {
			text-align: left;
		}
	}

	@media (max-width: 480px) {
		.site-footer {
			padding: 48px 20px 24px;
		}

		.footer-grid {
			gap: 30px 20px;
			padding-bottom: 45px;
		}

		.brand-title {
			font-size: 24px;
		}

		.footer-column a {
			font-size: 13px;
		}

		.footer-bottom-left {
			flex-direction: column;
			gap: 3px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-column a {
			transition: none;
		}
	}
</style>
