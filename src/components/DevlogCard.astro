
---
const { post } = Astro.props;


const isDeveloperNote = post.data.series === "developer-notes";

const seriesLabel = isDeveloperNote
	? "DEVELOPER NOTES"
	: "GUANCHE WARRIORS";


const { title, description, pubDate, category, cover } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric"
});
---

<article class="devlog-card">
	{cover && (
		<img src={cover} alt={title} class="card-image" />
	)}

	<div class="card-content">


        <div class="card-tags">
            <span class:list={["series-label", {
                "developer-note": isDeveloperNote
            }]}>
                {seriesLabel}
            </span>

            <span class="category">{category}</span>
        </div>


		<time datetime={pubDate.toISOString()}>
			{formattedDate}
		</time>

		<h2>{title}</h2>

		<p>{description}</p>

<a href={`${import.meta.env.BASE_URL}devlog/${post.id}/`}>
	READ ARTICLE →
</a>
	</div>
</article>

<style>
	.devlog-card {
		background: #242c32;
		border: 1px solid #394047;
		border-radius: 6px;
		overflow: hidden;
	}

	.card-image {
		width: 100%;
		height: 200px;
		object-fit: cover;
	}

	.card-content {
		padding: 24px;
	}

	.category {
		color: #d69b48;
		font-size: 11px;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	time {
		display: block;
		margin-top: 10px;
		color: #92999e;
		font-size: 12px;
	}

	h2 {
		color: #e8e0cf;
		font-size: 21px;
		margin: 16px 0 10px;
	}

	p {
		color: #aeb5b9;
		font-size: 14px;
		line-height: 1.7;
	}

	a {
		display: inline-block;
		margin-top: 14px;
		color: #d69b48;
		font-size: 12px;
		font-weight: bold;
		text-decoration: none;
	}

	a:hover {
		color: #e8e0cf;
	}

    .series-label {
        display: inline-block;
        padding: 6px 10px;
        background-color: #473a27;
        color: #e7b869;
        border-radius: 4px;
        font-size: 10px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .series-label.developer-note {
        background-color: #243f35;
        color: #93cfac;
    }

    .card-tags {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }


</style>
