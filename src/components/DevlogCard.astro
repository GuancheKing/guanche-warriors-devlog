
---
import type { CollectionEntry } from "astro:content";
import type { Language } from "../i18n/ui";

interface Props {
	post: CollectionEntry<"devlog">;
	lang?: Language;
}

const { post, lang = "en" } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const isDeveloperNote = post.data.series === "developer-notes";
const isSpanishPost = post.id.startsWith("es/");

const isEnglishFallback = lang === "es" && !isSpanishPost;

const seriesLabel = isDeveloperNote
	? "DEVELOPER NOTES"
	: "GUANCHE WARRIORS";

const {
	title,
	description,
	pubDate,
	category,
	cover,
} = post.data;

const formattedDate = pubDate.toLocaleDateString(
	lang === "es" ? "es-ES" : "en-GB",
	{
		day: "numeric",
		month: "long",
		year: "numeric",
	}
);

const coverUrl = cover
	? /^(https?:\/\/|data:)/.test(cover) ||
		cover.startsWith(base)
		? cover
		: `${base}${cover.replace(/^\/+/, "")}`
	: null;

const articleSlug = post.id
	.replace(/^en\//, "")
	.replace(/^es\//, "");

const articleUrl = isSpanishPost
	? `${base}es/devlog/${articleSlug}/`
	: `${base}devlog/${articleSlug}/`;

const readLabel = isEnglishFallback
	? "READ IN ENGLISH"
	: lang === "es"
		? "LEER ARTÍCULO"
		: "READ ARTICLE";
---

<article
	class:list={[
		"devlog-card",
		{
			"developer-note": isDeveloperNote,
		},
	]}
>
	{coverUrl && (
		<a
			href={articleUrl}
			class="card-image-link"
			aria-label={`${readLabel}: ${title}`}
			tabindex="-1"
		>
			<img
				src={coverUrl}
				alt=""
				class="card-image"
				loading="lazy"
				decoding="async"
			/>
		</a>
	)}

	<div class="card-content">
		<div class="card-tags">
			<span class="series-label">
				{seriesLabel}
			</span>

			{category && (
				<span class="category">
					{category}
				</span>
			)}
		</div>

		<time datetime={pubDate.toISOString()}>
			{formattedDate}
		</time>

		<h2>
			<a href={articleUrl} class="title-link">
				{title}
			</a>
		</h2>

		<p class="card-description">
			{description}
		</p>

		{isEnglishFallback && (
			<span class="language-note">
				Disponible en inglés
			</span>
		)}

		<a
			href={articleUrl}
			class="read-link"
			aria-label={`${readLabel}: ${title}`}
		>
			{readLabel}
			<span aria-hidden="true">→</span>
		</a>
	</div>
</article>

<style>
	.devlog-card {
		--card-accent: var(--color-coral);

		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 100%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.devlog-card.developer-note {
		--card-accent: var(--color-turquoise);
	}

	.devlog-card:hover,
	.devlog-card:focus-within {
		border-color: var(--card-accent);
	}

	.devlog-card:hover {
		transform: translateY(-3px);
	}

	/* COVER IMAGE */

	.card-image-link {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--color-background);
	}

	.card-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.devlog-card:hover .card-image {
		transform: scale(1.03);
	}

	/* CONTENT */

	.card-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 26px;
	}

	.card-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 18px;
	}

	.series-label {
		display: inline-block;
		padding: 6px 10px;
		border: 1px solid var(--card-accent);
		border-radius: 4px;
		color: var(--card-accent);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.7px;
		line-height: 1.3;
	}

	.category {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.6px;
		text-transform: uppercase;
	}

	time {
		display: block;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.2px;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: clamp(20px, 2vw, 24px);
		font-weight: 600;
		letter-spacing: -0.5px;
		line-height: 1.35;
		margin: 15px 0 12px;
	}

	.title-link {
		color: var(--color-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.title-link:hover,
	.title-link:focus-visible {
		color: var(--card-accent);
	}

	.card-description {
		color: var(--color-text-muted);
		font-size: 14px;
		line-height: 1.8;
		margin: 0 0 24px;
	}

	.language-note {
		color: var(--color-yellow);
		font-family: var(--font-mono);
		font-size: 11px;
		margin: 0 0 18px;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: auto;
		color: var(--card-accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.6px;
		text-decoration: none;
		transition:
			gap 0.2s ease,
			color 0.2s ease;
	}

	.read-link:hover {
		gap: 15px;
		color: var(--color-text);
	}

	.read-link span {
		font-size: 17px;
		line-height: 1;
	}

	.title-link:focus-visible,
	.read-link:focus-visible,
	.card-image-link:focus-visible {
		outline: 2px solid var(--card-accent);
		outline-offset: 4px;
	}

	/* RESPONSIVE */

	@media (max-width: 600px) {
		.card-content {
			padding: 22px;
		}

		h2 {
			font-size: 21px;
		}

		.card-tags {
			gap: 10px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.devlog-card,
		.card-image,
		.title-link,
		.read-link {
			transition: none;
		}

		.devlog-card:hover,
		.devlog-card:hover .card-image {
			transform: none;
		}
	}
</style>
